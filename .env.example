INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=changeme
INFLUX_ORG=solar
INFLUX_BUCKET=solar_logging
INFLUX_TOKEN=changeme-generate-a-random-token
GRAFANA_ADMIN_PASSWORD=changeme
INVERTER_HOST=192.168.1.2
INVERTER_PORT=1502
NUT_TELEGRAF_PASSWORD=changeme-generate-a-random-password
# --- Weather service (see README "Weather") ---
# Home point, 4 decimal places
WEATHER_LAT=37.0000
WEATHER_LON=-122.0000
# Primary NWS station, then ordered fallbacks used when it is stale or missing a value
WEATHER_STATION=LOAC1
WEATHER_FALLBACK_STATIONS=AW020,KNUQ
# ASOS airport station used for conditions text, cloud cover and visibility
SKY_STATION=KNUQ
# Search for another nearby station (find_station.py) when all of the above fail
WEATHER_FALLBACK_AUTO=true
# NWS asks for an app name and a contact address in the User-Agent
NWS_USER_AGENT=(solar_logging, you@example.com)
# Panel orientation for the tilted-irradiance estimate: tilt in degrees from
# flat; azimuth 0 = south, -90 = east, 90 = west
PANEL_TILT=20
PANEL_AZIMUTH=0
